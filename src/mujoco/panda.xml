<mujoco model="franka_panda">
  <option timestep="0.002" gravity="0 0 -9.81"/>
  <default>
    <joint armature="0.001" damping="1" limited="true"/>
    <geom conaffinity="0" condim="3" friction="1 0.1 0.1" rgba="0.8 0.8 0.8 1" solimp="0.9 0.95 0.01" solref="0.02 1"/>
  </default>

  <worldbody>
    <light pos="0 0 3" dir="0 0 -1" diffuse="1 1 1"/>
    <!-- Base table -->
    <body name="base" pos="0 0 0">
      <geom name="base_link" type="box" size="0.2 0.2 0.1" rgba="0.3 0.3 0.3 1"/>
      <!-- Panda arm joints -->
      <body name="link1" pos="0 0 0.333">
        <joint name="joint1" type="hinge" axis="0 0 1" range="-2.8973 2.8973"/>
        <geom type="capsule" fromto="0 0 0 0 0 0.315" size="0.06"/>
        <body name="link2" pos="0 0 0.315">
          <joint name="joint2" type="hinge" axis="0 1 0" range="-1.7628 1.7628"/>
          <geom type="capsule" fromto="0 0 0 0 0 0.392" size="0.06"/>
          <body name="link3" pos="0 0 0.392">
            <joint name="joint3" type="hinge" axis="0 0 1" range="-2.8973 2.8973"/>
            <geom type="capsule" fromto="0 0 0 0 0 0.089" size="0.06"/>
            <body name="link4" pos="0 0 0.089">
              <joint name="joint4" type="hinge" axis="0 -1 0" range="-3.0718 -0.0698"/>
              <geom type="capsule" fromto="0 0 0 0 0 0.392" size="0.06"/>
              <body name="link5" pos="0 0 0.392">
                <joint name="joint5" type="hinge" axis="0 0 1" range="-2.8973 2.8973"/>
                <geom type="capsule" fromto="0 0 0 0 0 0.10" size="0.06"/>
                <body name="link6" pos="0 0 0.10">
                  <joint name="joint6" type="hinge" axis="0 1 0" range="-0.0175 3.7525"/>
                  <geom type="capsule" fromto="0 0 0 0 0 0.094" size="0.06"/>
                  <body name="link7" pos="0 0 0.094">
                    <joint name="joint7" type="hinge" axis="0 0 1" range="-2.8973 2.8973"/>
                    <geom type="capsule" fromto="0 0 0 0 0 0.07" size="0.06"/>
                    <!-- Flange -->
                    <body name="flange" pos="0 0 0.07">
                      <geom type="box" size="0.03 0.03 0.01" rgba="0.2 0.2 0.2 1"/>
                      <!-- End effector site for force sensor -->
                      <site name="end_effector" pos="0 0 0.04" group="3"/>
                      <!-- Gripper slide joints -->
                      <body name="left_finger" pos="0 -0.02 0.02">
                        <joint name="finger_joint1" type="slide" axis="0 1 0" range="0 0.04"/>
                        <geom type="box" size="0.01 0.01 0.02" rgba="0.9 0.4 0.4 1"/>
                      </body>
                      <body name="right_finger" pos="0 0.02 0.02">
                        <joint name="finger_joint2" type="slide" axis="0 -1 0" range="0 0.04"/>
                        <geom type="box" size="0.01 0.01 0.02" rgba="0.4 0.4 0.9 1"/>
                      </body>
                    </body>
                  </body>
                </body>
              </body>
            </body>
          </body>
        </body>
      </body>
    </body>

    <!-- Workpiece surface for surface following -->
    <body name="scan_plane" pos="0.6 0 0.2">
      <geom name="surface_geom" type="box" size="0.4 0.4 0.01" rgba="0.7 0.2 0.2 1" solref="0.01 2"/>
    </body>

    <!-- Ground -->
    <geom name="ground" type="plane" size="5 5 0.1" rgba="0.95 0.95 0.95 1"/>
  </worldbody>

  <sensor>
    <force name="ft_sensor" site="end_effector"/>
  </sensor>

  <keyframe>
    <key name="home" qpos="0 -0.785 0 -2.356 0 1.5708 0.785 0.04 0.04"/>
  </keyframe>
</mujoco>
